    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    COALESCE(w.\"number\"::text, w.\"phone\"::text) AS \"telefone\",\n    CONCAT('https://api.galaxychat.com.br/v1/api/external/', a.\"id\"::text) AS \"url\",\n    COALESCE(a.\"token\"::text, a.\"authToken\"::text) AS \"token\",\n    w.\"name\"::text AS \"nome\"\nFROM \"ApiConfigs\" a\nINNER JOIN \"Whatsapps\" w ON w.\"id\" = a.\"sessionId\"\nWHERE a.\"isActive\" = true\n  AND (\n    COALESCE(w.\"number\"::text, w.\"phone\"::text) = '{{ $json.numero }}'\n  )\nORDER BY a.\"id\" DESC\nLIMIT 1;",
        "options": {}
