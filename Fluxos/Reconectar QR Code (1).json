        "jsCode": "const numero = $('2. FUNCTION').first().json.numero;\nglobalThis._qrRetries = globalThis._qrRetries || {};\nglobalThis._qrRetries[numero] = (globalThis._qrRetries[numero] || 0) + 1;\n\nconst MAX_TENTATIVAS = 3;\nconst tentativaAtual = globalThis._qrRetries[numero];\n\nif (tentativaAtual >= MAX_TENTATIVAS) {\n  delete globalThis._qrRetries[numero];\n  return [\n    {\n      json: {\n        erro: \"timeout\",\n        message: \"Tempo limite excedido ao tentar gerar o QR Code. Por favor, tente novamente.\",\n        limiteAtingido: true,\n        tentativa: tentativaAtual\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      limiteAtingido: false,\n      tentativa: tentativaAtual\n    }\n  }\n];"
      },
